<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="LoginForm"
    Title="LoginForm" Width="520" SizeToContent="Height" MinHeight="380" WindowStartupLocation="CenterScreen"  ShowInTaskbar="True" ResizeMode="NoResize" Icon="/image/logo.png" >
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions >
            <RowDefinition Height="100"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Grid.Column="0" Grid.Row="0" Height="70" Source="/image/invita logo.png" HorizontalAlignment="Left" Margin="15,0,0,0"  VerticalAlignment="Stretch" Visibility="Visible"  />
        <Image Grid.Column="1" Grid.Row="0" Source="/image/bbk logo.png" HorizontalAlignment="Right" Margin="0,0,15,0" VerticalAlignment="Stretch" Height="70" Visibility="Visible" />
        <Label Grid.Column="0" Grid.Row="1" Height="50" Grid.ColumnSpan="2" Margin="10,5,0,0" FontSize="25" Content="RecordManagementSolution" />
        <Grid Grid.Column="0" x:Name="Grid1" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Visible" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions >
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="#00829C" Grid.Column="0" Margin="0,0,10,0" Grid.Row="0" Height="30" Width="40" HorizontalAlignment="Right">
                <Image Source="/image/username.png" HorizontalAlignment="Stretch" Height="20" Width="30" VerticalAlignment="Stretch" />
            </Border>
            <Border Background="#00829C" Grid.Column="0" Margin="0,0,10,0" Grid.Row="1" Height="30" Width="40" HorizontalAlignment="Right">
                <Image Source="/image/password.png" HorizontalAlignment="Stretch" Height="20" Width="30" VerticalAlignment="Stretch" />
            </Border>
            <!--<Label Grid.Column="0"  Grid.Row="0" Content="User Name" HorizontalAlignment="left" VerticalAlignment="Center" Margin="35,10,0,10"/>
        <Label Grid.Column="0"  Grid.Row="1" Content="Password" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="35,10,0,10"/>-->
            <TextBox  Grid.Column="1" Name="txtusername"  TabIndex="0"  Grid.Row="0" VerticalContentAlignment="Center"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,20,10"/>
            <PasswordBox PreviewKeyDown="EnterClicked" Grid.Column="1"    Name="txtpassword" TabIndex="1"  Grid.Row="1" VerticalContentAlignment="Center"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,20,10"/>

            <Grid x:Name="LoginPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions >
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Label Name="lblLicStatus" Grid.Column="0"  Grid.Row="0" Content="Trial Version" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="35,0,0,12" Visibility="Collapsed"/>
                <Button Name="Btn_Activate_License" Visibility="Collapsed" Grid.Column="1"  Grid.Row="0" Content="Activate License" Background="#FFE88D12" Foreground="White" TabIndex="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,20,10"  />
                <StackPanel Grid.Column="0"  Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="btnlogin"  Content="Sign in" Width="100" TabIndex="3" HorizontalAlignment="Left" Margin="0,10,20,10"/>
                    <Button Name="btncancel" Content="Cancel" Width="100" TabIndex="5" HorizontalAlignment="Right" Margin="10,10,20,10" Visibility="Visible"/>
                </StackPanel>
                
            </Grid>

            <TextBlock Grid.Column="0" Name="lblresult" TextWrapping="Wrap" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Grid.ColumnSpan="2" Margin="20,0,20,10" Foreground="Red" FontWeight="Bold" FontSize="12"/>
        </Grid>
        <Grid x:Name="LicensePanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions >
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Label Name="lblLicStatus1" Grid.Column="0" Grid.Row="0" Content="License Key" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="35,10,0,10" />
            <TextBox Name="txtLicense" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,20,10" />
            <StackPanel Grid.Column="0"  Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="Btn_Activate" Grid.Column="0" Grid.Row="1" Content="Activate" Background="#FFE88D12" Foreground="White" HorizontalAlignment="Left" Margin="35,10,0,10" Width="100"  />
                <Button Name="Btn_Activate_Cancel"  Content="Cancel" HorizontalAlignment="Right"  Margin="10,10,20,10"  Width="100" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="0" x:Name="Grid2"  Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" >

            <Grid.RowDefinitions >
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Border Background="#00829C" Grid.Column="0"  Grid.Row="0" Height="30" Width="300" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/image/username.png"  Margin="5,0,0,0" HorizontalAlignment="Left" Height="20" Width="30" VerticalAlignment="Stretch" />
                    <Label Content="User:" Foreground="White" />
                    <Label Name="lblusername" Content="" Foreground="White" />
                </StackPanel>

            </Border>
            <StackPanel Grid.Column="0"  Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                <Label Content="Time To change your password!" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Your " Foreground="Gray" />
                    <Label Content="Password will expire in" Foreground="Red" />
                    <Label Name="lbldays" Content="" Foreground="Red" FontStyle="Italic" />
                    <Label Content="Days" Foreground="Red" FontStyle="Italic" />
                </StackPanel>

            </StackPanel>
            <StackPanel Grid.Column="0"  Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Stretch" >
                <Button Name="btnProceedlogin" Click="btnProceedlogin_Click" BorderBrush="Blue" Background="White" Foreground="Gray" Content="Proceed to Login>>" Width="130" TabIndex="3" HorizontalAlignment="Center" Margin="80,10,20,10"/>
                <Button Name="btnChangePW" Click="btnChangePW_Click" Background="#00829C" Foreground="White" Content="Change it now" Width="130" TabIndex="4" HorizontalAlignment="Center" Margin="0,10,0,10"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="0" x:Name="Grid3"  Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="0.3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions >
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="#00829C" Grid.Column="0"  Grid.Row="0" Height="30" Width="280" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/image/username.png"  Margin="5,0,0,0" HorizontalAlignment="Left" Height="20" Width="30" VerticalAlignment="Stretch" />
                    <Label Content="User:" Foreground="White" />
                    <Label Name="lblusername1" Content="" Foreground="White" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="0" Margin="10,0,10,0"  Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                <Label Grid.Column="0"  Grid.Row="0" Content="New Password" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <PasswordBox  x:Name="txtnewpw" Height="30"  Grid.Column="1" TabIndex="1"  Grid.Row="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Label Grid.Column="0"  Grid.Row="0" Content="Confirm New password" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <PasswordBox  Height="30"  Grid.Column="1" Name="txConfirmpassword" TabIndex="1"  Grid.Row="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <TextBlock  TextWrapping="Wrap" HorizontalAlignment="Left" Text="Your organization requires that your password inculde at least[8] characters,a capital letter,a lowercase letter and a special character." FontSize="10" Foreground="Gray" />
                <TextBlock Grid.Column="0" Name="lblresult1" Text=""  TextWrapping="Wrap" Grid.Row="3"  HorizontalAlignment="Left"  Grid.ColumnSpan="2" Margin="20,5,0,0" Foreground="Red" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="0"  Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="btnUpdate" Click="btnUpdate_Click" Background="#00829C" Foreground="White" Content="Update Password" Width="100" TabIndex="4" HorizontalAlignment="Right" Margin="10,0,0,10" />
            </StackPanel>

        </Grid>

        <Grid Grid.Column="0" x:Name="Grid4"  Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="0.3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions >
                <RowDefinition Height="50"/>
                <RowDefinition Height="75"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Border Background="#00829C" Grid.Column="0"  Grid.Row="0" Height="30" Width="280" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/image/username.png"  Margin="5,0,0,0" HorizontalAlignment="Left" Height="20" Width="30" VerticalAlignment="Stretch" />
                    <Label Content="User:" Foreground="White" />
                    <Label Name="lblusername2" Content="" Foreground="White" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="0" Margin="10,0,10,0"  Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                <Label Foreground="#00829C" FontWeight="Bold" Content="Successfully password reset!" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap"  Foreground="Gray"  Text="you can now use your new password to log in to your account!" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="0"  Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="btnloin" Click="btnloin_Click" Background="#00829C" Foreground="White" Content="Login" Width="100" TabIndex="4" HorizontalAlignment="Right" Margin="20,10,0,10"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
