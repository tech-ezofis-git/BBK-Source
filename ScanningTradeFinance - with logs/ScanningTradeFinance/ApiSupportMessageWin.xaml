<Window x:Class="ApiSupportMessageWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Height="420"
        Width="560"
        Title="API Support">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="LightBlue" SecondaryColor="DeepPurple" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Background="White"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0F766E" CornerRadius="8,8,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="API Support" Foreground="White" FontSize="16" FontWeight="Bold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border x:Name="badgeTeam" Margin="12,0,0,0" CornerRadius="10" Padding="10,2"
                                Background="#CCFBF1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblTeamBadge" Text="SUPPORT" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#115E59" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="btnCloseHeader" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Background="Transparent" BorderThickness="0"
                            Click="btnOk_Click" Cursor="Hand" ToolTip="Close">
                        <TextBlock Text="✕" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="16,14,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblSummary" Grid.Row="0" TextWrapping="Wrap"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           Foreground="#0F172A" Margin="0,0,0,12"/>

                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Function" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblFunction" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#0F172A" FontFamily="Consolas" Margin="0,2,0,10"/>

                            <TextBlock Text="Called from" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblCalledFrom" TextWrapping="Wrap" FontSize="13"
                                       Foreground="#0F172A" FontFamily="Consolas" Margin="0,2,0,10"/>

                            <TextBlock Text="Swagger URL" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblSwaggerUrl" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#0F172A" FontFamily="Consolas" Margin="0,2,0,10"/>

                            <TextBlock Text="Detail" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblDetail" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#334155" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="0,0,8,8" Padding="16,10">
                <Button x:Name="btnOk" Content="OK" Width="110" Height="34" HorizontalAlignment="Right"
                        Background="#0F766E" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Click="btnOk_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
