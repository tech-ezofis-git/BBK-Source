<UserControl x:Class="ECMLeftPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300">
    
<UserControl.Resources>
        
    <SolidColorBrush x:Key="ImportantForegroundBrush" Color="#FFD20000" />
        
        <Storyboard x:Key="BeginProgress" >
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="border2">
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/>               
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="border1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/>               
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="border1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/>               
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" Storyboard.TargetName="border1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/>              
            </DoubleAnimationUsingKeyFrames>
           

            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="border1">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:1.3" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:1.5" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="border2">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:1.3" Value="{x:Static Visibility.Visible}"/>               
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
       
    </UserControl.Resources>
    <Grid x:Name="gr" Background="#FF25A0DA" >
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="200*" MinHeight="100"/>
            <RowDefinition Height="50" />
            <RowDefinition Height="200*" MinHeight="100"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <CheckBox  Margin="10,5,0,0" Click="OnSelectAllChanged" Foreground="White" Name="selectAll" Content="Select All / Unselect All" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
            <Label x:Name="lb1" Margin="10,0,0,0" Content="Tif Formats" Foreground="White"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
            
        </StackPanel>
        <ListView x:FieldModifier="Public" Grid.Row="1" Margin="3"   SelectionChanged="lstTif_SelectionChanged"  Name="lstTif" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"   IsSynchronizedWithCurrentItem="True"   ItemsSource="{Binding}" AllowDrop="True">
            <ListView.View>
                <GridView >
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0"  
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}"  Unchecked="CheckBox_Unchecked"   />
                                
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="tifgrid" Width="300"   >
                       
                    </GridViewColumn>
                </GridView>
                
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2">
            <CheckBox  Margin="10,5,0,0" Click="otherselectall" Content="Select All / Unselect All" Name="otherselect" Foreground="White" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            <Label x:Name="lb2" Margin="10,0,0,0" Foreground="White" Content="Other Formats" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
           
        </StackPanel>
        <ListView x:FieldModifier="Public" Grid.Row="3" Margin="3" SelectionChanged="lstOther_SelectionChanged" Name="lstOther" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"   IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding}" >
            <ListView.View>
                <GridView  >
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0" 
                                          VerticalAlignment="Center" 
                                          IsChecked="{Binding	RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="othersgrid" Width="300">

                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Border x:Name="border2" Background="#B2FFFFFF" Opacity="0" Visibility="Collapsed" Height="auto" Grid.Row="0" Grid.RowSpan="4" />
        <Border x:Name="border1" Background="#F4FFFFFF" BorderBrush="#FF7A7A7A" BorderThickness="1"  Grid.Row="0" Grid.RowSpan="4"
				VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10 10 10 40"
				Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBlock Text="Processing ...." FontFamily="Segoe UI Light" FontSize="16"
					   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
        </Border>

    </Grid>



</UserControl>
