<Window x:Class="Versioning"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Versioning" Height="200" Width="550"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" 
    WindowStartupLocation="CenterScreen"  ShowInTaskbar="True" ResizeMode="NoResize" Icon="/ECMScanAndIndex;component/images/scanbig.ico">
    <Grid Margin="5">
        <Grid.RowDefinitions >
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"  Orientation="Horizontal">
            <Label  Content="File :" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Label  Name="lblfilename" Content="" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Label   Content="for the RIM Number (" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Label  Name="lblrim" Content="" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="Red" FontWeight="Bold" />
            <Label   Content=") Exisiting on the FileRepository. " HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </StackPanel>
      
        <Label Grid.Row="1" Content="Choose The Below Option To Take Action:"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Row="2" Grid.Column="0" Tag="0" Name="btnskip" GroupName="version" VerticalAlignment="Center" HorizontalAlignment="Center" Checked="Btnskip_Checked" >Skip To Delete Scanned File</RadioButton>
            <RadioButton Grid.Row="2" Grid.Column="1" Tag="2" Name="btnreplace" GroupName="version" VerticalAlignment="Center" HorizontalAlignment="Center" Checked="Btnreplace_Checked">Replace old file</RadioButton>
            <RadioButton Grid.Row="2" Grid.Column="2" Tag="1" Name="btnversion" GroupName="version" VerticalAlignment="Center" HorizontalAlignment="Center" Checked="Btnversion_Checked">Create file as new Version</RadioButton>
        </Grid>
        <StackPanel Grid.Column="0"  Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="btnsave" Background="White"  Content="Save" Width="100" TabIndex="3" HorizontalAlignment="Left" Margin="0,10,20,10" Click="btnsave_Click" />
        </StackPanel>
    </Grid>
</Window>
