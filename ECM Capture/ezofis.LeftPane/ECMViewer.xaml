<UserControl x:Class="ECMViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfi="clr-namespace:PdfiumViewer;assembly=PdfiumViewer"
             mc:Ignorable="d"   
             d:DesignHeight="300" d:DesignWidth="300" >
    

    <Grid Background="Gray" x:Name="MainGrid">
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="200*" />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Grid.ColumnSpan="3">

            <WindowsFormsHost Name="Host" Visibility="Visible"  HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" >

            </WindowsFormsHost>
            <WindowsFormsHost Visibility="Collapsed" Name="PdfwindowsFormsHost">
                <wf:Panel x:Name="pdfPanel"/>
            </WindowsFormsHost>
        </Grid>

        <Border x:Name="border1" Background="White" BorderBrush="Transparent"   Grid.Column="0"
				VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1"
				Opacity="0" Visibility="Visible"  >

            <Button  Background="Transparent"    Name="BtnPrevious" Click="BtnPrevious_Click">
                <Button.Template>
                    <ControlTemplate>
                        <Grid x:Name="bg" Opacity="0">
                            <Image Width="40" Height="40" Stretch="Fill" Source="/ezofis.UserControl;component/Images/Pre.png"></Image>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName ="bg" Property="Opacity" Value="1" />
                                <Setter TargetName ="bg" Property="Background" Value="LightGray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
        <Border x:Name="border2" Background="White" BorderBrush="Transparent"  Grid.Column="2" 
				VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1"
				Opacity="1" Visibility="Visible"  >
            <Button  Background="Transparent"  Name="BtnNext" Click="BtnNext_Click">

                <Button.Template>
                    <ControlTemplate>
                        <Grid x:Name="bg" Opacity="0">
                            <Image Width="40" Height="40" Stretch="Fill" Source="/ezofis.UserControl;component/Images/Next.png"></Image>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName ="bg" Property="Opacity" Value="1" />
                                <Setter TargetName ="bg" Property="Background" Value="LightGray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>

       
    </Grid>
</UserControl>
