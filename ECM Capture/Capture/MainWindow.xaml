                                        telerik:KeyTipService.AccessText="2" />
                        <telerik:RadDropDownButton Name="ddlang" Content="" Height="22" Width="20" DropDownWidth="100" />
                    </telerik:QuickAccessToolBar>
                </telerik:RadRibbonView.QuickAccessToolBar>
            </telerik:RadRibbonView>
        </StackPanel>
        <telerik:RadDockPanel Name="pan" Margin="2" Grid.Row="1" >
            <telerik:RadSplitContainer  Orientation="Horizontal" InitialPosition="DockedRight" Grid.ColumnSpan="2" Margin="0,0,0,0" Height="auto"  >
                <telerik:RadPaneGroup telerik:ProportionalStackPanel.RelativeSize="150 200" OverridesDefaultStyle="False" Height="auto">
                    <telerik:RadPane   Name="radf" PaneHeaderVisibility="Collapsed" ContextMenuTemplate="{x:Null}">
                        <ECM:ECMLeftPane x:Name="LeftPane" Margin="0" Tif_SelectionChanged="LeftPane_Tif_SelectionChanged" Tif_unchecked="LeftPane_Tif_checkedChanged"  
                                         Other_SelectionChanged="LeftPane_Other_SelectionChanged"/>
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
                <telerik:RadPaneGroup telerik:ProportionalStackPanel.RelativeSize="600 200" Height="auto" >
                    <telerik:RadPane   Name="rads" PaneHeaderVisibility="Collapsed" >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Panel -->
                            
                            <ECM:ECMViewer x:Name="ECMViewer" Grid.Row="1" />
                        </Grid>
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
                <telerik:RadPaneGroup telerik:ProportionalStackPanel.RelativeSize="150,200" Height="auto" >
                    <telerik:RadPane  Name="radt" PaneHeaderVisibility="Collapsed" ContextMenuTemplate="{x:Null}">
                        <ECM:ECMRightPane   x:Name="RightPane" Margin="0"/>
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
            </telerik:RadSplitContainer>
        </telerik:RadDockPanel>
        <StatusBar   Grid.Row="2" >
            <TextBlock  Name="stalab" Text ="Page"  Height="20" />
        </StatusBar>
        <Border x:Name="border2" Background="Transparent" Opacity="0" Visibility="Collapsed" Height="auto" Grid.Row="0" Grid.RowSpan="2" />
        <Border x:Name="border1" Background="Transparent" BorderBrush="#FF7A7A7A" BorderThickness="0"  Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right" 
				Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <Image VerticalAlignment="Stretch"  HorizontalAlignment="Stretch"   Height="25" gif:ImageBehavior.AutoStart="True"  gif:ImageBehavior.AnimatedSource="Images/logo.gif" />
        </Border>
        <Border Background="Transparent" BorderBrush="#FF7A7A7A" VerticalAlignment="Top" HorizontalAlignment="Right"  Grid.Row="0" Margin="0,0,20,0">
            <StackPanel Background="Transparent">
                <Image  Source="Images/Logo.png"  Margin="0,0,2,0"   Height="48"   />
            </StackPanel>
        </Border>
        <Border x:Name="border4" Background="#B2FFFFFF" Opacity="0" Visibility="Collapsed" Height="auto" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" />
        <Border x:Name="border3" Background="#643094" BorderBrush="#FF7A7A7A" BorderThickness="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
				VerticalAlignment="Top" HorizontalAlignment="Right" Margin="30 60 30 40"
				Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBlock Text="Processing ...." FontFamily="Segoe UI Light" FontSize="16" Background="#643094" Foreground="White"
					   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
        </Border>
    </Grid>
</Window>
