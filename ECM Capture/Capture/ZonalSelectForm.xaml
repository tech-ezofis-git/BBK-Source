<Window x:Class="SelectZonalFile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zonal File" Height="171" Width="309" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow">
    <Grid Height="138">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="160*" />          
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height ="50" />
            <RowDefinition Height="34*" />
            <RowDefinition Height="54*" />
        </Grid.RowDefinitions>
        <Label Content="Zonal File" Height="28" HorizontalAlignment="Left" Margin="12,18,0,0" Name="Label1" VerticalAlignment="Top" />
        <ComboBox Grid.Column="1" SelectedValue="{Binding ZonalName}" ItemsSource="{Binding}" DisplayMemberPath="ZonalName" SelectedValuePath="ZonalName"   Height="23" HorizontalAlignment="Stretch" Margin="0,18,10,8" Name="ComboBox1" VerticalAlignment="Stretch"  />
        <Button Grid.Row="2" Content="Done" Height="23" HorizontalAlignment="Left" Margin="10,19,0,0" Name="BtnSelectZonal" VerticalAlignment="Top" Width="75" Grid.Column="1" />
        <Label Content="Zonal File Name" Height="28" HorizontalAlignment="Left" Margin="12,6,0,0" Name="Label2" VerticalAlignment="Top" Grid.Row="1" />
        <TextBox Grid.Column="1" Grid.Row="1" Height="23" HorizontalAlignment="Left" Margin="0,6,0,0" Name="TxtZonalName" VerticalAlignment="Top" Width="167" />
        <Button Content="Done" Height="23" HorizontalAlignment="Left" Margin="10,19,0,0" Name="BtnSaveZonal" VerticalAlignment="Top" Width="75" Grid.Column="1" Grid.Row="2" />
    </Grid>
</Window>
