<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Database" type="System.Configuration.NameValueSectionHandler"/>
    <section name="api" type="System.Configuration.NameValueSectionHandler"/>
  </configSections>
  <api>

    <add key="api" value="http://localhost/invitaAPI"/>
    <add key="Monitor" value="D:\Capture 1"/>
	  <add key="TemplateidCAD" value="17" />
	  <add key="TemplateidCredit" value="17" />
    <add key="ScanningStation" value="D:\vinsi\Veoneer\API\Publish\Monitor"/>
  </api>
  <Database>
    <add key="Imagefiles" value="c:\imaging"/>
   
   <add key="bjQRmrCJaKTQcBDLo92d6Q==" value="iorvB37lM/3g0nnU+V4fmRf9RnLMCe7ypHsgFMjwlX0="/>
    <add key="yGJzq3uI1QAWR2w9Q4EqcA==" value="1"/>
