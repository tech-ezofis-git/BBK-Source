///////////////////////////////////
  
  Modules of KADMOS and KADMOS-CL

///////////////////////////////////

[PROTECT]
N_A01=Internal error (PP API) #%lX
N_C01=Current version:
N_C02=Code entry:
N_C03=Computer ID:
N_C04=Cancel
N_C05=Corrupt license file: #%lX
N_C06=Corrupt classifier file %s 
N_D01=Demo version
N_D02=Drive 'A:' does not exist.\nYou can save %s on disk after closing this application.
N_E01=Error #%lX
N_H01=Help
N_J01=Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec 
N_L01=Licensing %s
N_L02=Licensing aborted
N_L03=Later...
N_L04=Label a floppy disk 'KADMOS Version %s Licence' and insert it into drive A:.\nSelect OK when the disk is in the drive.
N_N01=Next invitation to authorize KADMOS
N_N02=Next run
N_O01=Only %ld days left
N_O02=Only one day left
N_O03=of your application
N_P01=Please copy the file %s into the directory %s
N_P02=Please copy the file %s into the system directory or set a path
N_P03=Preliminary authorization
N_P04=Please contact your software distributor to get the correct trigger code
N_P05=Product description:
N_P06=Please enter first a valid trigger code
N_R01=Recognition engine %s\nExclusively licensed for\n
N_R02=Recognition engine %s authorized.\nDo you want to save the licence file on disk (recommended)?
N_S01=%s.Dll corrupt
N_S02=%s is not licensed for the used version
N_S03=%s %s\nExpiration date: %d-%s-%d
N_S04=%s %s expired
N_S05=%s not authorized for this computer
N_S06=%s%s not found
N_T01=The licence trigger code was incorrect\nTry again
N_T02=This is the last day for preliminary authorization
N_T03=Trigger code:
N_T04=The file already exists. Overwrite?
N_T05=Trial time has terminated\nYou have to get a trigger code
N_T06=Tomorrow
N_U01=Unauthorized function call
N_Y01=Your clock has been turned back\nPlease correct and re-run application
N_Y02=Your maximal number of licensing attempts has been reached\nPlease contact the distributor of the application


