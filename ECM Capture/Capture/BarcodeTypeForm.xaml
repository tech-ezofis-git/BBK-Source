<Window x:Class="BarcodeTypeForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BarcodeType" Height="131" Width="291" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow">
    <Grid Height="88">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="150*" />          
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height ="50" />
            <RowDefinition Height="50*" />
        </Grid.RowDefinitions>
        <Label Content="Barcode Type" Height="28" HorizontalAlignment="Left" Margin="12,18,0,0" Name="Label1" VerticalAlignment="Top" />
        <ComboBox Grid.Column="1" Grid.Row="0" SelectedValue="{Binding BarcodeType}" ItemsSource="{Binding}" DisplayMemberPath="BarcodeType" SelectedValuePath="BarcodeType"   Height="23" HorizontalAlignment="Stretch" Margin="10,10,10,0" Name="ComboBox1" VerticalAlignment="Stretch"  />
        <Button Grid.Column="1" Grid.Row="1" Content="Done" Height="23" HorizontalAlignment="Left" Margin="10,10,0,0" Name="Button1" VerticalAlignment="Top" Width="75" />
    </Grid>
</Window>
