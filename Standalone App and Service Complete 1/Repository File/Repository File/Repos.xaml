<Window x:Class="Repos"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Repository_File"
             mc:Ignorable="d" 
             Width="650" Height="250" ResizeMode="NoResize"  WindowStartupLocation="CenterScreen" WindowStyle="None"   AllowsTransparency="True">

    <!-- AllowsTransparency="True" -->
    <Border BorderThickness="1" BorderBrush="Black" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1.5*"/>
               
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>

                <Grid x:Name="mainheader" Grid.Row="0" Background="White" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"   Background="#FF6D2F9E">
                    </Grid>
                    <Grid Grid.Column="1"   Background="#FF6D2F9E">
                        <StackPanel HorizontalAlignment="Left" >
                            <Label Content="1.Repository Access" Foreground="white" FontSize="16"  />
                            <Border BorderThickness="1"  BorderBrush="White" Width="147" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="2" Background="#FF44ABD5">
                    </Grid>

                    <Grid Grid.Column="3" Background="#FF44ABD5">
                    <StackPanel HorizontalAlignment="Left" >
                            <Label Content="2.Encrypt/Decrypt Processing" Foreground="white" FontSize="16" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="0" Grid.ColumnSpan="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Resources/ezofis-Mark-White.png" Margin="0,-10,0,-10" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="3">
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="Btn_cancel"  ToolTip="close"  HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent">
                                <Image Source="/Resources/close-icon8.png"  Height="35" Width="35" />
                                <!--<Image Source="/Resources/close-icon6.png" Height="35" Width="35"  />-->
                                <!--<Image  Source="/Resources/close-icon2.jpg" Height="35" Width="35"/>-->
                            </Button>
                        </StackPanel>
                    </Grid>
                    
                </Grid>
                

            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>


                <Label Grid.Column="0" Height="34" Margin="10,10" Content="Repository" HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="16"/>
                <Label Grid.Column="0" Height="34"  Content="*" HorizontalAlignment="Right" Foreground="Red" FontFamily="Segoe UI" FontSize="16"/>
                <TextBox Grid.Column="1" x:Name="Repname" Height="28" FontSize="15" BorderBrush="#FF7CCBE8" Foreground="Gray" Margin="10,10" />
                <Button Grid.Column="2" x:Name="Btn_choosefolder" Content="Choose Folder" Foreground="White" Margin="10,10" BorderBrush="White" Background="#FFE88D12" Height="29"/>

            </Grid>
            <Grid  Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" x:Name="domain" Height="34"  Content="Domain" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Right"/>
                <TextBox  Grid.Row="0" Grid.Column="1" x:Name="txtdomain" Height="28" FontSize="15" BorderBrush="#FF7CCBE8" Foreground="Gray" Margin="10,0" />


                <Label Grid.Row="1" Grid.Column="0" Height="34"  Content="Access User" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Right"/>
                <TextBox  Grid.Row="1" Grid.Column="1" x:Name="username1" Height="28" FontSize="15" BorderBrush="#FF7CCBE8" Foreground="Gray" Margin="10,0"/>

                <Label Grid.Row="2" Grid.Column="0" Height="34"  Content="Access Password" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Right"/>
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="password" Password="password"  Height="28" FontSize="15" BorderBrush="#FF7CCBE8" Foreground="Gray" Margin="10,0" />

                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" x:Name="Btn_getcon" Content="Check Connection" FontSize="14" Foreground="White" BorderBrush="White" Margin="10" Background="#FF48B1D8"/>
            </Grid>

            

            <!--
            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                <StackPanel>
                    <Label Height="34" Margin="30,10,451,0" Content="Access Username" FontFamily="Segoe UI" FontSize="15"/>
                    <TextBox x:Name="username1" Height="28" FontSize="15" BorderBrush="#FF7CCBE8" Foreground="Gray" Margin="183,-35,130,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Grid.ColumnSpan="3">
                <StackPanel>
                    <Label Height="34" Margin="30,10,451,0" Content="Access Password" FontFamily="Segoe UI" FontSize="15"/>
                    <PasswordBox x:Name="password" Password="password"  Height="28" FontSize="15" BorderBrush="#FF7CCBE8" Foreground="Gray" Margin="183,-35,130,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3" Grid.ColumnSpan="3">
                <StackPanel Margin="182,0,130,0">
                    <Button x:Name="Btn_getcon" Content="Get Connection" FontSize="14" Foreground="White" Margin="0,10,176,0" BorderBrush="White" Background="#FF48B1D8" Height="29"/>
                    <Button x:Name="Btn_cancel" Content="Cancel" Foreground="White" FontSize="14" Margin="176,-29,0,0" BorderBrush="White" Background="#FFF72525" Height="29"  />

                </StackPanel>

            </Grid>
            <Label Content="@EZOFIS INC. All Rights Reserved" Margin="185.422,56,186,-40" Foreground="Gray" Height="35" Grid.Row="3" Grid.Column="2"/>-->


        </Grid>
    </Border>
</Window>
