<Window x:Class="Popup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="680" Width="1080" WindowStartupLocation="CenterScreen"  ResizeMode="NoResize" WindowStyle="None"   AllowsTransparency="True" Background="#B2FFFFFF" Opacity="1" >
    <Border BorderThickness="1" BorderBrush="SandyBrown" CornerRadius="5"  Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="1" Visibility="Visible" RenderTransformOrigin="0.5,0.5" Height="250" Width="550">
        <Border.RenderTransform>
            <TransformGroup>
                <!--<ScaleTransform ScaleX="0.5" ScaleY="0.5"/>-->
                <SkewTransform/>
                <RotateTransform Angle="0"/>
                <TranslateTransform/>
            </TransformGroup>
        </Border.RenderTransform>
        
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border BorderThickness="0" BorderBrush="SandyBrown">
                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Left" Background="SandyBrown">
                        <Label Content="EZOFIS STANDALONE APP:NOTIFY" Margin="10,5,20,5" FontSize="16" Foreground="White"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" >
                        <Button x:Name="Btn_cancel" Background="Transparent" BorderBrush="White" ToolTip="close" >
                            <Image Source="/Resources/close-icon8.png" Height="35" Width="35"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>


            <Grid Grid.Row="1">
                <Grid x:Name="DecryptGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="0.75*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"  x:Name="Labelpass1" Content="Decrypt Password" FontSize="14" FontStyle="Normal" FontWeight="Regular" Margin="5"  HorizontalAlignment="Left" VerticalAlignment="Center" ></Label>
                    <PasswordBox Grid.Row="0" Grid.Column="1"  x:Name="PasswordboxDecrypt" Password="Password"  Height="30" BorderBrush="#FF7CCBE8" Foreground="gray" FontSize="14" Margin="5"  ></PasswordBox>
                    <Button  Grid.Row="0" Grid.Column="2"  x:Name="btnDecryptChkPwd"  Content="Check Password" FontSize="12" BorderBrush="White" FontFamily="Roboto" Foreground="White" Background="#FFE88D12" Margin="5" Height="30" />



                    <Label Grid.Row="1" Grid.Column="0" x:Name="labelKeepBothFilesDecrypt" Content="Original File Required?"  FontSize="14" FontStyle="Normal" FontWeight="Regular"  Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center"  ></Label>
                    <RadioButton Grid.Row="1" Grid.Column="1"  x:Name="RBKeepBothFilesDecrypt"  GroupName="OriginalFileReq" Content="Keep Both File" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="#FF7CCBE8"  Foreground="gray" FontSize="14" IsChecked="True"  Margin="5">
                        

                    </RadioButton>
                    <RadioButton Grid.Row="1" Grid.Column="2"  x:Name="RBReplaceFilesDecrypt"  GroupName="OriginalFileReq" Content="Replace Original Files" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="#FF7CCBE8"  Foreground="gray" FontSize="14"  Margin="5"  />

                    <Label x:Name="decryptpath" Content="label" Visibility="Hidden"  ></Label>

                    <Grid Grid.Row="2" Grid.ColumnSpan="3">
                        <StackPanel>
                            <Button x:Name="BtnDecryptInitProcess"  Content="Initiate Process" FontSize="12" BorderBrush="White" FontFamily="Roboto" Foreground="Gray" Background="#FF00A2FF" HorizontalAlignment="Center" VerticalAlignment="Top" Height="30" Margin="10" Width="130" IsEnabled="False"/>

                            <Label x:Name="wrongpassDecrypt" Content="Invalid password...!" Visibility="Collapsed" FontSize="14" Margin="10,-25,250,0" Foreground="Red" Height="28"/>
                        </StackPanel>
                    </Grid>
                </Grid>


                <Grid x:Name="DownloadGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <!--<RowDefinition Height="1*"/>-->
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="0.75*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"  x:Name="Labelpass" Content="Download Password" Height="27" FontSize="14" FontStyle="Normal" FontWeight="Regular"  Margin="5"  ></Label>
                    <PasswordBox Grid.Row="0" Grid.Column="1"  x:Name="passwordboxDownload" Password="Password"  Height="30" BorderBrush="#FF7CCBE8" Foreground="gray" FontSize="14"  Margin="5"></PasswordBox>
                    <Button  Grid.Row="0" Grid.Column="2"  x:Name="btnDownloadChkPwd"  Content="Check Password" FontSize="12" BorderBrush="White" FontFamily="Roboto" Foreground="White" Background="#FFE88D12" Margin="5" Height="30" />


                    <Label Grid.Row="1" Grid.Column="0" x:Name="Labeldes" Content="Destination Folder" Height="27" FontSize="14" FontStyle="Normal" FontWeight="Regular"  Margin="5" ></Label>
                    <TextBox  Grid.Row="1" Grid.Column="1"  x:Name="Destfolder"   Height="30" BorderBrush="#FF7CCBE8" Foreground="gray"   FontSize="14"  Margin="5" />
                    <Button  Grid.Row="1" Grid.Column="2"  x:Name="btnchsefolder"  Content="Choose folder"   FontSize="12" BorderBrush="White" FontFamily="Roboto" Foreground="White" Background="#FFE88D12" Margin="5" Height="30"  />




                    <!--<Label Grid.Row="2" Grid.Column="0" x:Name="labelKeepBothFiles" Content="Keep Both Files" Height="27" FontSize="14" FontStyle="Normal" FontWeight="Regular"  ></Label>
                    <CheckBox  Grid.Row="2" Grid.Column="1"  x:Name="CBKeepBothFilesDownload" Height="20" Width="20" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="#FF7CCBE8"  Foreground="gray"   FontSize="14" />-->


                    <Grid Grid.Row="2" Grid.ColumnSpan="3" >
                        <StackPanel>
                            <Button x:Name="BtnDownloadInitProcess"  Content="Initiate Process" FontSize="12" BorderBrush="White" FontFamily="Roboto" Foreground="Gray" Background="#FF00A2FF" HorizontalAlignment="Center" Height="30" Margin="10" Width="130" IsEnabled="False" />
                            <Label x:Name="wrongpassDownload" Content="Invalid password...!" Visibility="Collapsed" FontSize="14" Margin="10,-25,250,0" Foreground="Red" Height="28"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
